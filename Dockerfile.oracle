# MicroPython v1.29.0 oracle: host mpy-cross and the 32-bit mpycore unix
# variant. Both are built once in this image. Bytecode is emitted later
# with -msmall-int-bits=31, no -march, and -O0 (see oracle-header).
FROM python:3.14-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc-i686-linux-gnu \
        g++-i686-linux-gnu \
        libc6:i386 \
        patch \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY vendor/micropython /src/vendor/micropython
COPY variants/mpycore /src/variants/mpycore

# Patch and compile inside the image. MPY_SRC skips the host-side copy.
ENV MPY_SRC=/src/vendor/micropython

RUN sh /src/variants/mpycore/build.sh mpy-cross \
    && sh /src/variants/mpycore/build.sh variant \
    && cp /src/vendor/micropython/mpy-cross/build/mpy-cross /usr/local/bin/mpy-cross \
    && cp /src/vendor/micropython/ports/unix/build-mpycore/micropython /usr/local/bin/upycore-oracle \
    && chmod 755 /src/variants/mpycore/oracle-header.sh /src/variants/mpycore/oracle-smoke.sh \
    && ln -sf /src/variants/mpycore/oracle-header.sh /usr/local/bin/oracle-header \
    && ln -sf /src/variants/mpycore/oracle-smoke.sh /usr/local/bin/oracle-smoke

# Runtime paths. Set after the build so the compile uses the tree binaries.
ENV MPY_CROSS=/usr/local/bin/mpy-cross
ENV ORACLE_BIN=/usr/local/bin/upycore-oracle
ENV MPY_PIN_H=/src/vendor/micropython/py/persistentcode.h

CMD ["oracle-header"]
